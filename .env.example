# ─────────────────────────────────────────────────────────────────────────────
# Metro CRM API configuration. Copy to `.env` for local development.
# Values marked REQUIRED must be set in every environment; the app refuses to
# start with missing or invalid configuration (see src/config/env.ts).
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development            # development | test | production
APP_ENV=local                   # local | staging | production (enables stricter checks)
PORT=5000
HOST=0.0.0.0
LOG_LEVEL=info                  # fatal | error | warn | info | debug | trace | silent
# Number of reverse proxies in front of the API (load balancer, Nginx, Render,
# Railway...). Needed so rate limiting sees real client IPs. Usually 1 when hosted.
TRUST_PROXY=0
BODY_LIMIT=100kb
# Swagger UI at /api/docs. Defaults to on everywhere except APP_ENV=production.
# API_DOCS_ENABLED=true

# ── Database (REQUIRED) ──────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/metro_crm?schema=public"

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma separated, exact origins (scheme + host + port). No "*" outside local.
# CRM frontend(s). REQUIRED outside local.
CORS_ORIGINS=http://localhost:3000
# Public website(s), allowed only on /api/v1/public/* endpoints.
PUBLIC_CORS_ORIGINS=http://localhost:4000

# ── Authentication (REQUIRED) ────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Use a different secret per environment. Never commit a real value.
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_ISSUER=metro-crm-api

# ── Rate limiting (per client IP, per window) ────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000     # 15 minutes
RATE_LIMIT_MAX=300              # whole API
RATE_LIMIT_AUTH_MAX=20          # login / token refresh
RATE_LIMIT_PUBLIC_MAX=10        # public website form submissions

# ── Captcha for public website forms ─────────────────────────────────────────
# Provider: none | turnstile | recaptcha | hcaptcha
#   turnstile → Cloudflare Turnstile   (dash.cloudflare.com → Turnstile)
#   recaptcha → Google reCAPTCHA v3     (google.com/recaptcha/admin)
#   hcaptcha  → hCaptcha                (dashboard.hcaptcha.com)
# "none" disables the check and is rejected when APP_ENV=production.
# The website sends the token it gets from the widget in the X-Captcha-Token header.
# The SITE key goes into the website frontend; only the SECRET key goes here.
CAPTCHA_PROVIDER=none
CAPTCHA_SECRET_KEY=
# reCAPTCHA v3 only: minimum score to accept (0.0 bot … 1.0 human).
CAPTCHA_MIN_SCORE=0.5
# Optional: only accept tokens solved on these hostnames (comma separated).
CAPTCHA_ALLOWED_HOSTNAMES=
CAPTCHA_TIMEOUT_MS=5000

# ── Session security ─────────────────────────────────────────────────────────
REFRESH_TOKEN_TTL_DAYS=7        # sign-in session length (refresh token lifetime)
BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5            # failed sign-ins before a temporary lock
LOGIN_LOCK_MINUTES=15

# ── First Super Admin (used once by `npm run db:seed`) ───────────────────────
# Remove the password from the environment after the account has been created.
SEED_SUPER_ADMIN_NAME="Super Admin"
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
