// Database schema. Conventions (see docs/MODULE_STANDARD.md#database):
//  - Models: PascalCase singular. Tables/columns: snake_case via @@map / @map.
//  - Ids: String @id @default(uuid()) @db.Uuid; timestamps: DateTime @db.Timestamptz(3)
//  - Business tables carry createdAt, updatedAt, deletedAt (soft delete),
//    createdById, updatedById.
//  - Every foreign key and every column used for filtering/sorting is indexed.
//  - Never hard delete business data; history relations use onDelete: Restrict.
// After editing: npm run db:migrate -- --name <what_changed>

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  SALES_MANAGER
}

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  name                String    @db.VarChar(100)
  /// Always stored lowercased. Stays reserved after a soft delete (restore instead of recreating).
  email               String    @unique @db.VarChar(254)
  passwordHash        String    @map("password_hash")
  role                Role
  isActive            Boolean   @default(true) @map("is_active")
  mustChangePassword  Boolean   @default(false) @map("must_change_password")
  /// Incremented to revoke every access and refresh token of the user at once.
  tokenVersion        Int       @default(0) @map("token_version")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(3)
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz(3)
  passwordChangedAt   DateTime? @map("password_changed_at") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdById         String?   @map("created_by_id") @db.Uuid
  updatedById         String?   @map("updated_by_id") @db.Uuid

  refreshTokens        RefreshToken[]
  assignedEnquiries    Enquiry[]             @relation("EnquiryAssignee")
  enquiryFollowUps     EnquiryFollowUp[]
  enquiryStatusChanges EnquiryStatusChange[]
  uploadedMedia        Media[]               @relation("MediaUploader")
  notifications        Notification[]        @relation("UserNotifications")

  @@index([role])
  @@index([deletedAt, createdAt])
  @@map("users")
}

/// Opaque, rotating refresh tokens. Only the SHA-256 hash is stored.
/// A family is one sign-in session; reuse of a rotated token revokes the whole family.
model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.Char(64)
  tokenVersion Int       @map("token_version")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdByIp  String?   @map("created_by_ip") @db.VarChar(64)
  userAgent    String?   @map("user_agent") @db.VarChar(512)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

enum EnquiryStatus {
  NEW
  ASSIGNED
  CONTACTED
  QUOTATION_SENT
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

/// A product enquiry, submitted from the public website.
model Enquiry {
  id           String        @id @default(uuid()) @db.Uuid
  name         String        @db.VarChar(100)
  company      String?       @db.VarChar(150)
  email        String        @db.VarChar(254)
  mobile       String        @db.VarChar(20)
  city         String?       @db.VarChar(100)
  state        String?       @db.VarChar(100)
  country      String?       @db.VarChar(100)
  message      String?       @db.VarChar(2000)
  status       EnquiryStatus @default(NEW)
  salesNotes   String?       @map("sales_notes") @db.VarChar(5000)
  assignedToId String?       @map("assigned_to_id") @db.Uuid
  assignedAt   DateTime?     @map("assigned_at") @db.Timestamptz(3)
  closedAt     DateTime?     @map("closed_at") @db.Timestamptz(3)
  sourceIp     String?       @map("source_ip") @db.VarChar(64)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime?     @map("deleted_at") @db.Timestamptz(3)
  createdById  String?       @map("created_by_id") @db.Uuid
  updatedById  String?       @map("updated_by_id") @db.Uuid

  assignedTo    User?                 @relation("EnquiryAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)
  lineItems     EnquiryLineItem[]
  followUps     EnquiryFollowUp[]
  statusChanges EnquiryStatusChange[]

  @@index([status])
  @@index([assignedToId])
  @@index([deletedAt, createdAt])
  @@index([email])
  @@map("enquiries")
}

model EnquiryLineItem {
  id          String   @id @default(uuid()) @db.Uuid
  enquiryId   String   @map("enquiry_id") @db.Uuid
  productId   String   @map("product_id") @db.VarChar(100)
  sku         String   @db.VarChar(100)
  productName String?  @map("product_name") @db.VarChar(200)
  quantity    Int
  /// Order in which the customer listed the items (0-based).
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Restrict)

  @@index([enquiryId])
  @@index([sku])
  @@map("enquiry_line_items")
}

/// Append-only log of sales activity on an enquiry.
model EnquiryFollowUp {
  id        String   @id @default(uuid()) @db.Uuid
  enquiryId String   @map("enquiry_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  note      String   @db.VarChar(2000)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Restrict)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([enquiryId, createdAt])
  @@index([authorId])
  @@map("enquiry_follow_ups")
}

/// Append-only audit trail of status changes.
model EnquiryStatusChange {
  id          String         @id @default(uuid()) @db.Uuid
  enquiryId   String         @map("enquiry_id") @db.Uuid
  fromStatus  EnquiryStatus? @map("from_status")
  toStatus    EnquiryStatus  @map("to_status")
  changedById String?        @map("changed_by_id") @db.Uuid
  note        String?        @db.VarChar(1000)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  enquiry   Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Restrict)
  changedBy User?   @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([enquiryId, createdAt])
  @@index([changedById])
  @@map("enquiry_status_changes")
}

/// Product brand representation.
model Brand {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(100)
  nameKey     String    @unique @map("name_key") @db.VarChar(100)
  slug        String    @unique @db.VarChar(120)
  description String?   @db.VarChar(2000)
  logoUrl     String?   @map("logo_url") @db.VarChar(500)
  bannerUrl   String?   @map("banner_url") @db.VarChar(500)
  isActive    Boolean   @default(true) @map("is_active")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid

  products Product[]

  @@index([deletedAt, sortOrder, name])
  @@index([deletedAt, isActive])
  @@index([name])
  @@map("brands")
}

/// Product category representation.
model Category {
  id            String    @id @default(uuid()) @db.Uuid
  name          String    @db.VarChar(100)
  nameKey       String    @unique @map("name_key") @db.VarChar(100)
  slug          String    @unique @db.VarChar(120)
  imageUrl      String?   @map("image_url") @db.VarChar(500)
  imageMediaId  String?   @map("image_media_id") @db.Uuid
  bannerUrl     String?   @map("banner_url") @db.VarChar(500)
  bannerMediaId String?   @map("banner_media_id") @db.Uuid
  description   String?   @db.VarChar(2000)
  isActive      Boolean   @default(true) @map("is_active")
  sortOrder     Int       @default(0) @map("sort_order")
  parentId      String?   @map("parent_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdById   String?   @map("created_by_id") @db.Uuid
  updatedById   String?   @map("updated_by_id") @db.Uuid

  parent      Category?  @relation("CategoryParent", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[] @relation("CategoryParent")
  products    Product[]
  imageMedia  Media?     @relation("CategoryImageMedia", fields: [imageMediaId], references: [id], onDelete: SetNull)
  bannerMedia Media?     @relation("CategoryBannerMedia", fields: [bannerMediaId], references: [id], onDelete: SetNull)

  @@index([deletedAt, sortOrder, name])
  @@index([deletedAt, isActive])
  @@index([deletedAt, createdAt])
  @@index([parentId])
  @@index([imageMediaId])
  @@index([bannerMediaId])
  @@index([name])
  @@map("categories")
}

enum ProductStatus {
  DRAFT
  PUBLISHED
}

/// Product representation.
model Product {
  id              String        @id @default(uuid()) @db.Uuid
  name            String        @db.VarChar(200)
  slug            String        @unique @db.VarChar(120)
  sku             String        @unique @db.VarChar(100)
  brandId         String        @map("brand_id") @db.Uuid
  categoryId      String        @map("category_id") @db.Uuid
  description     String?       @db.Text
  price           Decimal?      @db.Decimal(12, 2)
  priceVisibility Boolean       @default(true) @map("price_visibility")
  status          ProductStatus @default(DRAFT)
  hotDeal         Boolean       @default(false) @map("hot_deal")
  imageUrl        String?       @map("image_url") @db.VarChar(500)
  specifications  Json?         @db.JsonB
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz(3)
  createdById     String?       @map("created_by_id") @db.Uuid
  updatedById     String?       @map("updated_by_id") @db.Uuid

  brand         Brand                 @relation(fields: [brandId], references: [id], onDelete: Restrict)
  category      Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  galleryImages ProductGalleryImage[]
  videos        ProductVideo[]
  documents     ProductDocument[]

  @@index([brandId])
  @@index([categoryId])
  @@index([status])
  @@index([hotDeal])
  @@index([deletedAt, createdAt])
  @@index([name])
  @@map("products")
}

/// Product gallery image (maximum 5 active images per product).
model ProductGalleryImage {
  id          String    @id @default(uuid()) @db.Uuid
  productId   String    @map("product_id") @db.Uuid
  mediaId     String    @map("media_id") @db.Uuid
  sortOrder   Int       @default(0) @map("sort_order")
  isPrimary   Boolean   @default(false) @map("is_primary")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@index([productId, deletedAt, sortOrder])
  @@index([mediaId])
  @@index([deletedAt, createdAt])
  @@map("product_gallery_images")
}

/// Product PDF document (maximum 3 active documents per product).
model ProductDocument {
  id               String    @id @default(uuid()) @db.Uuid
  productId        String    @map("product_id") @db.Uuid
  mediaId          String    @map("media_id") @db.Uuid
  title            String    @db.VarChar(200)
  originalFileName String?   @map("original_file_name") @db.VarChar(255)
  sortOrder        Int       @default(0) @map("sort_order")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdById      String?   @map("created_by_id") @db.Uuid
  updatedById      String?   @map("updated_by_id") @db.Uuid

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@index([productId, deletedAt, sortOrder])
  @@index([mediaId])
  @@index([deletedAt, createdAt])
  @@map("product_documents")
}

/// Product video (maximum 2 active videos per product).
model ProductVideo {
  id          String    @id @default(uuid()) @db.Uuid
  productId   String    @map("product_id") @db.Uuid
  mediaId     String    @map("media_id") @db.Uuid
  title       String?   @db.VarChar(200)
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@index([productId, deletedAt, sortOrder])
  @@index([mediaId])
  @@index([deletedAt, createdAt])
  @@map("product_videos")
}

/// Uploaded media asset tracked in CRM Media Library.
model Media {
  id           String    @id @default(uuid()) @db.Uuid
  fileName     String    @map("file_name") @db.VarChar(255)
  storageKey   String    @map("storage_key") @db.VarChar(500)
  publicUrl    String    @map("public_url") @db.VarChar(500)
  mimeType     String    @map("mime_type") @db.VarChar(100)
  fileSize     Int       @map("file_size")
  uploadedById String?   @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdById  String?   @map("created_by_id") @db.Uuid
  updatedById  String?   @map("updated_by_id") @db.Uuid

  uploadedBy           User?                 @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  productGalleryImages ProductGalleryImage[]
  productVideos        ProductVideo[]
  productDocuments     ProductDocument[]
  categoryImages       Category[]            @relation("CategoryImageMedia")
  categoryBanners      Category[]            @relation("CategoryBannerMedia")

  @@index([deletedAt, createdAt])
  @@index([fileName])
  @@index([mimeType])
  @@index([publicUrl])
  @@map("media")
}

enum ContactStatus {
  NEW
  READ
  ARCHIVED
}

/// A contact form submission from the public website.
model ContactSubmission {
  id        String        @id @default(uuid()) @db.Uuid
  name      String        @db.VarChar(100)
  email     String        @db.VarChar(254)
  mobile    String?       @db.VarChar(20)
  company   String?       @db.VarChar(150)
  subject   String?       @db.VarChar(200)
  message   String        @db.VarChar(2000)
  pageUrl   String?       @map("page_url") @db.VarChar(500)
  status    ContactStatus @default(NEW)
  sourceIp  String?       @map("source_ip") @db.VarChar(64)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime?     @map("deleted_at") @db.Timestamptz(3)
  createdById String?       @map("created_by_id") @db.Uuid
  updatedById String?       @map("updated_by_id") @db.Uuid

  @@index([status])
  @@index([deletedAt, createdAt])
  @@index([email])
  @@index([name])
  @@map("contact_submissions")
}

/// In-app notification for CRM users.
model Notification {
  id              String    @id @default(uuid()) @db.Uuid
  recipientUserId String    @map("recipient_user_id") @db.Uuid
  type            String    @db.VarChar(50)
  title           String    @db.VarChar(200)
  message         String    @db.VarChar(2000)
  readAt          DateTime? @map("read_at") @db.Timestamptz(3)
  entityType      String?   @map("entity_type") @db.VarChar(50)
  entityId        String?   @map("entity_id") @db.Uuid
  idempotencyKey  String?   @unique @map("idempotency_key") @db.VarChar(128)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdById     String?   @map("created_by_id") @db.Uuid
  updatedById     String?   @map("updated_by_id") @db.Uuid

  recipient User @relation("UserNotifications", fields: [recipientUserId], references: [id], onDelete: Restrict)

  @@index([recipientUserId, deletedAt, createdAt])
  @@index([recipientUserId, deletedAt, readAt, createdAt])
  @@map("notifications")
}

/// Homepage section representation for public website and CRM CMS management.
/// Single-instance active sections (HERO, FEATURED_PRODUCTS, FEATURED_CATEGORIES, FEATURED_BRANDS)
/// are constrained atomically via PostgreSQL partial unique index: homepage_sections_single_instance_active_idx.
model HomepageSection {
  id          String    @id @default(uuid()) @db.Uuid
  type        String    @db.VarChar(50)
  title       String?   @db.VarChar(200)
  subtitle    String?   @db.VarChar(500)
  content     Json      @db.JsonB
  sortOrder   Int       @default(0) @map("sort_order")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid

  @@index([deletedAt, isActive, sortOrder])
  @@index([deletedAt, sortOrder])
  @@index([deletedAt, type])
  @@map("homepage_sections")
}

