# Used only by the automated test suite (npm test) and CI. Not a secret.
NODE_ENV=test
APP_ENV=local
LOG_LEVEL=silent
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/metro_crm_test?schema=public"
JWT_ACCESS_SECRET="test-only-access-secret-at-least-32-characters-long"
JWT_ACCESS_TTL=15m
BCRYPT_ROUNDS=4
CORS_ORIGINS="http://crm.test"
PUBLIC_CORS_ORIGINS="http://website.test"
RATE_LIMIT_MAX=100000
RATE_LIMIT_AUTH_MAX=100000
RATE_LIMIT_PUBLIC_MAX=100000
CAPTCHA_PROVIDER=none
